{
  "layer": "top",
  "reload_style_on_change": true,
  "margin": 5,
  "spacing": 5,
  // modules start
  "modules-left": [
    "hyprland/workspaces",
    "custom/separator",
    "hyprland/window",
    "custom/separator",
    // "image#album-cover",
    "mpris"
  ],
  "modules-center": ["clock"],
  "modules-right": ["network", "tray", "group/system"],
  // modules end
  "hyprland/workspaces": {
    "format": "{icon}{windows}",
    "format-window-separator": "",
    "window-rewrite-default": "  ",
    "window-rewrite": {
      "class<org.qutebrowser.qutebrowser>": " 󰰜 ",
      "class<alacritty|kitty>": "  ",
      "class<discord>": " 󰙯 ",
      "class<Minecraft.*>": " 󰍳 ",
      "title<ncspot>|class<Spotify>": "  ",
      "title<btop>": " 󰝪 ",
      "class<godot>": "  ",
      "class<firefox>": "  ",
      "title<pulsemixer>": "  ",
      "title<(nv|nvim|c |conf |notes).*>": "  ",
      "title<ranger>": " 󱧶 ",
      "title<bluet.*>": " 󰂯 ",
      "title<neomutt.*>": " 󰇮 ",
      "title<calcur.*>": "  ",
      "title<steam>": " 󰓓 ",
      "class<.*qpwgraph>": " 󰘮 ",
      "class<mpv>": "  ",
      "class<pcmanfm>": "  ",
      "class<org.qbittorrent.qBittorrent>": "  ",
      "class<google-chrome>": "  "
    },
    "active-only": false,
    "all-outputs": false,
    "persistent-workspaces": {
      "*": 10
    },
    "show-special": true,
    "workspace-taskbar": {
      "enable": true,
      "format": " {icon}"
    }
  },

  "hyprland/window": {
    "max-length": 40,
    "format": "{title}",
    "icon": true,
    "rewrite": {
      "": "🖥️ Desktop"
    }
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "exec": "acpi -b | grep -o '[0-9]\\+%' | tr -d '%'",
    "format": "{}% {icon}",
    "format-icons": {
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
  },
  "clock": {
    "interval": 1,
    "format": "{:%a. %d/%m/%y 󰥔 %H:%M}",
    "format-alt": "{:%A %d %B %Y 󰥔 %H:%M:%S}",
    "tooltip-format": "{}"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 1
  },
  "cpu": {
    "interval": 5,
    "format": "{usage}% ",
    "max-length": 10
  },
  "memory": {
    "interval": 5,
    "format": "{percentage}% ",
    "max-length": 10
  },
  "disk": {
    "interval": 30,
    "format": "{free} 󱛟",
    "unit": "GB"
  },
  "temperature": {
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["󱃃"]
  },
  "custom/separator": {
    "format": ""
  },
  "group/hardware": {
    "modules": ["disk", "cpu", "memory", "temperature"],
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "not-power",
      "transition-left-to-right": false
    }
  },
  "image#album-cover": {
    "exec": "~/.scripts/get-album-cover",
    "size": 32,
    "signal": 10
  },
  "mpris": {
    "format": "{status_icon} {artist} - {title}",
    "title-len": 10,
    "artist-len": 10,
    "player-icons": {
      "default": "⏸",
      "ncspot": ""
    },
    "status-icons": {
      "paused": "▶",
      "playing": "⏸"
    },
    "ignored-players": ["firefox", "chromium"],
    "on-click": "swayosd-client --playerctl play-pause --player=spotify",
    "on-scroll-up": "playerctl volume $(echo $(playerctl volume) + 0.05 | bc) && swayosd-client --custom-progress=$(playerctl volume) --custom-icon=multimedia-volume-control",
    "on-scroll-down": "playerctl volume $(echo $(playerctl volume) - 0.05 | bc) && swayosd-client --custom-progress=$(playerctl volume) --custom-icon=multimedia-volume-control"
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "{signalStrength}% {icon}",
    "format-ethernet": "Eth. 󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} {frequency}Ghz",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "format-icons": { "wifi": ["󰤟", "󰤢", "󰤥", "󰤨"] },
    "on-click": "iwgtk"
  },
  "group/system": {
    "modules": [
      "disk",
      "custom/updates",
      "custom/separator",
      "backlight",
      "pulseaudio",
      "custom/microphone",
      "custom/separator",
      "battery",
      "power-profiles-daemon"
    ],
    "orientation": "horizontal"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "Muted 󰸈 ",
    // "format-source": "",
    // "format-source-muted": "󰍭",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "alsa_output.usb-1532_Razer_Barracuda_X_2.4_O001000007-00.analog-stereo": [
        "󰋋"
      ]
    },
    "on-scroll-up": "swayosd-client --output-volume +1",
    "on-scroll-down": "swayosd-client --output-volume -1",
    "on-click": "swayosd-client --output-volume mute-toggle"
  },
  "custom/microphone": {
    "exec": "~/.config/waybar/scripts/microphone.sh",
    "format": "{icon}",
    "format-icons": {
      "alsa_input.usb-1532_Razer_Barracuda_X_2.4_O001000007-00.mono-fallback|no": "󰋎",
      "alsa_input.usb-1532_Razer_Barracuda_X_2.4_O001000007-00.mono-fallback|yes": "󰋐",

      "alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source|no": "",
      "alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source|yes": "󰍭",

      "default": ""
    },
    "interval": 1,
    "return-type": "json"
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["", "󱎖", ""],
    "on-scroll-up": "swayosd-client --brightness raise",
    "on-scroll-down": "swayosd-client --brightness lower",
    "on-click-right": "swayosd-client --brightness 100",
    "on-click": "swayosd-client --brightness 1"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "on-click": "powerprofilesctl set $( [ \"$(powerprofilesctl get)\" = \"performance\" ] && echo power-saver || echo performance )",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "custom/weather": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 900
  },
  "custom/updates": {
    "format": "{} 󰚰",
    "exec-if": "which paru",
    "exec": "echo \"$(paru -Qu --repo | grep -v '\\[ignored\\]' | wc -l) / $(paru -Qu --aur |grep -v '\\[ignored\\]' | wc -l)\"",
    "on-click-right": "",
    "on-click": "alacritty -e paru -Syu",
    "interval": "once"
  }
}
